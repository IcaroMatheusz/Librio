{
  "expo": {
    "name": "Librio",
    "slug": "librio",
    "scheme": "librio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.librio.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.librio.mobile"
    }
  }
}
