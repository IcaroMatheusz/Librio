{
  "expo": {
    "name": "Librio",
    "slug": "librio",
    "scheme": "librio",
    "version": "0.3.2",
    "icon": "./assets/librio-icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171A27",
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-font",
      "expo-status-bar",
      "./plugins/withAndroidReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.librio.mobile",
      "icon": "./assets/librio-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/librio-icon.png",
        "backgroundColor": "#190A05"
      }
    },
    "ios": {
      "bundleIdentifier": "com.librio.mobile"
    }
  }
}
